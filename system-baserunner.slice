#
# Aggregate CPU budget for every baserunner@<site>.service instance combined.
#
# Each baserunner@.service instance sets its own per-site CPUQuota=100% (one
# runaway job guard), but that alone does not bound what happens when many
# sites burst at once (e.g. at boot) - this slice does. Sized for a
# t4g.xlarge (4 vCPUs = 400% in systemd terms): CPUQuota=300% leaves
# headroom for vis.py, interactive pilot logins, and AUV logins even if
# every site is busy simultaneously. CPUWeight=50 (half the systemd
# default of 100) means this slice yields CPU to those other consumers
# under contention rather than competing evenly with them.
#
# Both values are a starting point - retune using real data once
# CPUAccounting is live for a few days:
#
#   systemctl show system-baserunner.slice -p CPUQuota,CPUUsageNSec
#   systemd-cgtop
#
# Installation:
#
# sudo cp system-baserunner.slice /etc/systemd/system/system-baserunner.slice
# sudo systemctl daemon-reload
#
# baserunner@.service already references this slice via Slice=; each site's
# unit joins it the next time that site's baserunner@<site>.service is
# (re)started.
#
[Unit]
Description=Aggregate CPU budget for all baserunner@ site instances

[Slice]
CPUAccounting=yes
CPUQuota=300%
CPUWeight=50
